{
  "name": "RFP Intelligence Orchestrator",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        300
      ],
      "id": "orch-trigger",
      "name": "Trigger Orchestration (Schedule / Manual)"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5678/webhook/tender-detection",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"trigger_source\": \"master_orchestrator\",\n  \"requested_at\": new Date().toISOString()\n}",
        "options": {
          "timeout": 60000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        300
      ],
      "id": "orch-step-1-detection",
      "name": "1. Execute Tender Detection Module",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5678/webhook/prospect-research",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body || $json) }}",
        "options": {
          "timeout": 60000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        300
      ],
      "id": "orch-step-2-prospect",
      "name": "2. Execute Prospect Research Module (Serper + Groq)",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5678/webhook/generate-proposal",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body || $json) }}",
        "options": {
          "timeout": 90000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        300
      ],
      "id": "orch-step-3-proposal",
      "name": "3. Execute RAG & Proposal Engine Module",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const result = $input.first()?.json?.body || $input.first()?.json || {};\n\nreturn [{\n  json: {\n    pipeline_status: 'COMPLETED_SUCCESSFULLY',\n    orchestrated_at: new Date().toISOString(),\n    deliverable: result,\n    dashboard_stream_ready: true\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1400,
        300
      ],
      "id": "orch-step-4-dashboard",
      "name": "4. Deliver to Person C Dashboard"
    }
  ],
  "connections": {
    "Trigger Orchestration (Schedule / Manual)": {
      "main": [
        [
          {
            "node": "1. Execute Tender Detection Module",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "1. Execute Tender Detection Module": {
      "main": [
        [
          {
            "node": "2. Execute Prospect Research Module (Serper + Groq)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "2. Execute Prospect Research Module (Serper + Groq)": {
      "main": [
        [
          {
            "node": "3. Execute RAG & Proposal Engine Module",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "3. Execute RAG & Proposal Engine Module": {
      "main": [
        [
          {
            "node": "4. Deliver to Person C Dashboard",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}