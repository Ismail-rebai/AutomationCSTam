# ========================================================
# CSTAM OliveSoft RFP Intelligence Platform - Secrets
# ========================================================
# Copy this file to .env and insert your personal API keys.
# NEVER commit .env to public version control!

# Groq LLM API Key (Free tier from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Serper Google Search API Key (Free tier from https://serper.dev)
SERPER_API_KEY=your_serper_api_key_here

# Qdrant Vector Store URL (leave empty for automatic local in-memory fallback)
QDRANT_URL=
