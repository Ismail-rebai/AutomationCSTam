# === Embedding Backend ===
# Options: tfidf | e5
EMBEDDING_BACKEND=tfidf
# E5 model variant (only used when EMBEDDING_BACKEND=e5)
# Options: intfloat/multilingual-e5-small | intfloat/multilingual-e5-base | intfloat/multilingual-e5-large
E5_MODEL=intfloat/multilingual-e5-base

# === Qdrant ===
# Set to a running Qdrant server URL, e.g. http://localhost:6333
# Leave empty for automatic local/in-memory fallback
QDRANT_URL=

# === Groq (for tender structuring) ===
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# === Structuring ===
# Auto-structure tenders on ingest
STRUCTURE_ON_INGEST=false

# === Fusion ===
# Options: rrf | weighted
FUSION_METHOD=rrf
# RRF k parameter (default 60)
RRF_K=60
# Dense weight for weighted fusion (0.0 = BM25 only, 1.0 = dense only)
DENSE_WEIGHT=0.5

# === Cross-encoder reranker (optional) ===
# Set model name to enable, e.g. cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_MODEL=

# === Server ===
RAG_HOST=0.0.0.0
RAG_PORT=8001
INGEST_HOST=0.0.0.0
INGEST_PORT=8002

# === Data paths ===
DATA_DIR=data
INGEST_DB_PATH=data/ingest.db
